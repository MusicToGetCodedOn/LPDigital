generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id
  title       String
  category    String   // 'privat' oder 'gibb'
  tags        String   // Komma-getrennt (z.B. "React,Node.js,API")
  shortDesc   String
  problem     String   // Abstract: Ausgangslage
  solution    String   // Abstract: Umsetzung
  result      String   // Abstract: Ergebnis
  imageUrl    String?  // Optionaler Pfad zum Bild (z.B. "/projects/stalkr.png")
  githubUrl   String?  // Optionaler Link zum GitHub Repo
  liveUrl     String?  // Optionaler Link zur Live-Demo
  createdAt   DateTime @default(now())
}
model Language {
  id       String @id @default(uuid())
  name     String // z.B. "Deutsch"
  level    String // z.B. "Muttersprache" oder "C1"
  flagUrl  String // z.B. "/flags/deutsch.png"
  order    Int    @default(0) // Für die Reihung in der Liste
}

model Document {
  id          String   @id
  title       String
  category    String   // 'lebenslauf', 'zeugnisse', 'zertifikate'
  fileUrl     String   // Relativer Pfad z.B. "/documents/lebenslauf.pdf"
  fileSize    String   // z.B. "1.2 MB"
  updatedAt   DateTime @default(now())
}