generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Project {
  id               String   @id @default(uuid())
  title            String
  category         String   // 'privat' oder 'gibb'
  tags             String   // Komma-getrennt (z.B. "React,Node.js,API")
  description      String   // Kurzbeschreibung des Projekts
  
  // Project Abstract (nachgib-Vorlage)
  initialSituation String   // Ausgangslage / Aufgabenstellung
  technologies     String   // Verwendete Technologien (z.B. "Node.js, Express, Docker")
  implementation   String   // Umsetzung / Herausforderungen
  results          String   // Ergebnisse und Erfolge
  learnings        String   // Erkenntnisse / Lernerfahrung
  
  // Medien & Links
  imageUrl         String?  // Pfad zum Titelbild (z.B. "/projects/stalkr.png")
  documentUrl      String?  // Pfad zum Download-Dokument (z.B. "/documents/abstract-stalkr.pdf")
  githubUrl        String?  // Link zum GitHub Repo
  liveUrl          String?  // Link zur Live-Demo
  
  createdAt        DateTime @default(now())
}
model Language {
  id       String @id @default(uuid())
  name     String // z.B. "Deutsch"
  level    String // z.B. "Muttersprache" oder "C1"
  flagUrl  String // z.B. "/flags/deutsch.png"
  order    Int    @default(0) // Für die Reihung in der Liste
}

model Document {
  id          String   @id
  title       String
  category    String   // 'lebenslauf', 'zeugnisse', 'zertifikate'
  fileUrl     String   // Relativer Pfad z.B. "/documents/lebenslauf.pdf"
  fileSize    String   // z.B. "1.2 MB"
  updatedAt   DateTime @default(now())
}